{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "radarclip-match/1",
  "description": "A whole parsed CS2 match: every round as a full-round radarclip/1 clip. See radarclip-match-1.md.",
  "type": "object",
  "required": ["format", "map", "tickrate", "players", "rounds"],
  "properties": {
    "format": {"const": "radarclip-match/1"},
    "map": {"type": "string", "minLength": 1},
    "tickrate": {"type": "integer", "minimum": 1},
    "parser": {"type": "string"},
    "players": {
      "type": "array",
      "items": {"type": "object", "required": ["key", "name"], "properties": {"key": {"type": "string", "minLength": 1}, "name": {"type": "string"}}}
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "seconds", "keys", "clip"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "seconds": {"type": "number", "minimum": 0},
          "winner": {"enum": ["CT", "T", null]},
          "keys": {"type": "array", "items": {"type": "string"}},
          "clip": {"$ref": "radarclip-1.schema.json"},
          "detail": {
            "description": "Loadouts, money, sight and defuse attempts, on the round clip's frames.",
            "type": "object",
            "required": ["gear", "players"],
            "properties": {
              "gear": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
              "players": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["gear", "money", "equip", "helmet", "kit", "seen"],
                  "properties": {
                    "gear": {"$ref": "#/$defs/changes"},
                    "money": {"$ref": "#/$defs/changes"},
                    "equip": {"$ref": "#/$defs/changes"},
                    "helmet": {"$ref": "#/$defs/changes"},
                    "kit": {"$ref": "#/$defs/changes"},
                    "seen": {"$ref": "#/$defs/changes"}
                  }
                }
              },
              "defuses": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["t", "kit", "end"],
                  "properties": {
                    "t": {"type": "integer"},
                    "by": {"type": "integer", "minimum": 0},
                    "kit": {"type": "boolean"},
                    "end": {"type": "integer"},
                    "done": {"type": "boolean"}
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "changes": {"description": "Change list: [frame, value, frame, value, …].", "type": "array", "items": {"type": "integer"}}
  }
}
